{
  "id": "3fa3c09b6c7c474c",
  "name": "智联职位采集→飞书→Ollama评估→看板",
  "nodes": [
    {
      "id": "7a74f4bb6e9149ce849e1951c0aa7f47",
      "name": "手动触发",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        400
      ],
      "parameters": {}
    },
    {
      "id": "a1482778d3ae4358bab5fa025d1f0d84",
      "name": "每日定时触发",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        560
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "ca6fcf1da4aa4ad0b2b680308c33389c",
      "name": "配置",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [
        240,
        400
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "107373ebd217491cb89773e135a54411",
              "name": "keywords",
              "type": "array",
              "value": [
                "AI解决方案架构师",
                "云计算架构师",
                "解决方案架构师"
              ]
            },
            {
              "id": "55ba9e62a95f4abcbebada785356226f",
              "name": "city",
              "type": "string",
              "value": "广州"
            },
            {
              "id": "df4d0bba5da04355a7e8964c9940b874",
              "name": "maxPages",
              "type": "number",
              "value": 3
            },
            {
              "id": "a80d6d3e4fa440ba823dae87e64094b8",
              "name": "maxJobs",
              "type": "number",
              "value": 50
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "2861f5c21b644f17988a78c66bd02c18",
      "name": "获取飞书Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://open.feishu.cn/open-apis/auth/v3/tenant_access_token/internal",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"app_id\":\"={{ $vars.feishuAppId }}\",\"app_secret\":\"={{ $vars.feishuAppSecret }}\"}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "position": [
          240,
          640
        ]
      }
    },
    {
      "id": "8d356e059dd14d40a7a1344469cc2b35",
      "name": "拆分关键词",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst c = $input.first().json;\nreturn (c.keywords || []).map(kw => ({ json: { kw, city: c.city, maxPages: c.maxPages, maxJobs: c.maxJobs } }));\n"
      }
    },
    {
      "id": "1104782da41443248af63dcf1a671fb7",
      "name": "调用智联爬虫",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:7800/search",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"kw\":\"={{ $json.kw }}\",\"city\":\"={{ $json.city }}\",\"max_pages\":{{ $json.maxPages }},\"max_jobs\":{{ $json.maxJobs }}}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "position": [
          720,
          400
        ]
      }
    },
    {
      "id": "fe06ce6f2e3845fead793f750a3cc9c4",
      "name": "展开职位",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst out = [];\nfor (const item of $input.all()) {\n  const jobs = item.json.jobs || [];\n  for (const j of jobs) out.push({ json: j });\n}\nreturn out;\n"
      }
    },
    {
      "id": "7b5464e384dc45f3b05f0224328b8ce3",
      "name": "Ollama评估",
      "type": "n8n-nodes-base.ollama",
      "typeVersion": 1,
      "position": [
        1200,
        400
      ],
      "parameters": {
        "prompt": "你是一名资深招聘顾问。请基于以下职位信息做综合评估并生成简报（用中文）：\\n职位名：{{ $json.title }}\\n公司：{{ $json.company_name }}\\n薪资：{{ $json.salary_raw }}\\n地点：{{ $json.city }}{{ $json.district }}\\n经验：{{ $json.experience }}\\n学历：{{ $json.education }}\\n描述：{{ $json.description }}\\n\\n请输出：\\n1) 技术方向判断；\\n2) 学历要求；\\n3) 经验要求；\\n4) 与「广州黄埔 AI/云计算/解决方案架构师」目标的匹配度(高/中/低)及一句话理由；\\n5) 给求职者的行动建议。",
        "model": "qwen3:8b",
        "ollamaHost": "http://host.docker.internal:11434",
        "options": {
          "temperature": 0.3
        }
      }
    },
    {
      "id": "50d1deb9daaf415690a6b8527563dc2f",
      "name": "组装负载",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        400
      ],
      "parameters": {
        "mode": "runForEachItem",
        "jsCode": "\nconst j = item.json;\nconst evalText = (j.text || \"\").trim();\nlet match = \"中\";\nconst m = evalText.match(/匹配度[：:]\\s*(高|中|低)/);\nif (m) match = m[1];\nconst feishu_text = `【职位评估简报】\\n职位：${j.title}\\n公司：${j.company_name}`\n  + `\\n薪资：${j.salary_raw || '面议'}\\n地点：${j.city || ''}${j.district ? ('·' + j.district) : ''}`\n  + `\\n经验：${j.experience || '-'} | 学历：${j.education || '-'}\\n\\n${evalText}`\n  + `\\n\\n🔗 ${j.job_url || ''}`;\nconst bitable_fields = {\n  \"平台\": j.platform || \"智联\",\n  \"职位名\": j.title,\n  \"公司名\": j.company_name,\n  \"薪资范围\": j.salary_raw || \"\",\n  \"工作地点\": (j.city || \"\") + (j.district ? (\"·\" + j.district) : \"\"),\n  \"经验\": j.experience || \"\",\n  \"学历\": j.education || \"\",\n  \"描述\": (j.description || \"\").slice(0, 4000),\n  \"原始链接\": j.job_url || \"\",\n  \"评估结论\": evalText.slice(0, 2000),\n  \"匹配度\": match,\n  \"抓取时间\": new Date(j.crawled_at || Date.now()).getTime()\n};\nitem.json = Object.assign({}, j, { feishu_text, bitable_fields, match, evaluation: evalText });\nreturn item;\n"
      }
    },
    {
      "id": "5a2d548893a4457aa31fe84d862fcbe3",
      "name": "写飞书多维表格",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://open.feishu.cn/open-apis/bitable/v1/apps/{{ $vars.feishuBitableAppToken }}/tables/{{ $vars.feishuBitableTableId }}/records/batch_create",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"records\":[{\"fields\": {{ $json.bitable_fields }}}]}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "position": [
          1680,
          280
        ],
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('获取飞书Token').first().json.tenant_access_token }}"
            }
          ]
        }
      }
    },
    {
      "id": "2ae8ae685e86403fb563f31ea4f253ba",
      "name": "发飞书群",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://open.feishu.cn/open-apis/im/v1/messages?receive_id_type=chat_id",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"receive_id\":\"={{ $vars.feishuGroupChatId }}\",\"msg_type\":\"text\",\"content\":\"={{ JSON.stringify({text: $json.feishu_text}) }}\"}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "position": [
          1680,
          440
        ],
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('获取飞书Token').first().json.tenant_access_token }}"
            }
          ]
        }
      }
    },
    {
      "id": "e4152fafe5484da4a96a6e2f83dd4e8d",
      "name": "落看板数据",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://jobhunter2-dashboard:8100/api/jobs/ingest",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"platform\":\"={{ $json.platform }}\",\"title\":\"={{ $json.title }}\",\"company_name\":\"={{ $json.company_name }}\",\"salary_raw\":\"={{ $json.salary_raw }}\",\"city\":\"={{ $json.city }}\",\"district\":\"={{ $json.district }}\",\"experience\":\"={{ $json.experience }}\",\"education\":\"={{ $json.education }}\",\"job_url\":\"={{ $json.job_url }}\",\"description\":\"={{ $json.description }}\",\"evaluation\":\"={{ $json.evaluation }}\",\"match\":\"={{ $json.match }}\",\"crawled_at\":\"={{ $json.crawled_at }}\",\"evaluated_at\":\"={{ $now.toISO() }}\"}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "position": [
          1680,
          600
        ]
      }
    }
