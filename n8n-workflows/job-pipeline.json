{
  "id": "c53e4fc37e6649bd",
  "name": "智联职位采集→飞书→Ollama评估→看板 (RouteB)",
  "nodes": [
    {
      "id": "953d31e4bbdf4173ad7e60a4f3761907",
      "name": "手动触发",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        400
      ],
      "parameters": {}
    },
    {
      "id": "a4fbff0d527946bbb87fbe623fd00ded",
      "name": "每日定时触发",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        560
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "654ea71825e8451380c1609b5a408b44",
      "name": "配置",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [
        240,
        400
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "dad63784fc1f4bcf94056db653127bca",
              "name": "keywords",
              "type": "array",
              "value": [
                "AI解决方案架构师",
                "云计算架构师",
                "解决方案架构师",
                "售前解决方案工程师"
              ]
            },
            {
              "id": "f9ecd840b48442eb9e76ec193447b0bc",
              "name": "maxJobs",
              "type": "number",
              "value": 50
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "8289a95a264846ddaf41fcb96b17472f",
      "name": "获取飞书Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://open.feishu.cn/open-apis/auth/v3/tenant_access_token/internal",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"app_id\":\"={{ $vars.feishuAppId }}\",\"app_secret\":\"={{ $vars.feishuAppSecret }}\"}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "position": [
          240,
          720
        ]
      }
    },
    {
      "id": "aba986adf11749bd89c14750c8d1ad38",
      "name": "调用智联爬虫",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8911/crawl/zhilian?keywords={{ $json.keywords.join(',') }}&max_jobs={{ $json.maxJobs }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "position": [
          480,
          400
        ]
      }
    },
    {
      "id": "33a306f07fdd49dca42ed633c302adb4",
      "name": "写飞书多维表格",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8911/sync/feishu/push",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "position": [
          720,
          560
        ]
      }
    },
    {
      "id": "540a49fe46e64bb88e7c9464c41c7e46",
      "name": "拉取职位",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:8911/jobs?matched=true&limit=200",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "position": [
          720,
          400
        ]
      }
    },
    {
      "id": "21a805692ab54f8faa73d5dec26708fd",
      "name": "展开职位",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst out = [];\nfor (const item of $input.all()) {\n  const d = item.json;\n  if (Array.isArray(d)) { for (const j of d) out.push({ json: j }); }\n  else if (Array.isArray(d.jobs)) { for (const j of d.jobs) out.push({ json: j }); }\n  else if (Array.isArray(d.data)) { for (const j of d.data) out.push({ json: j }); }\n  else { out.push({ json: d }); }\n}\nreturn out;\n"
      }
    },
    {
      "id": "9b52d089a06c4fec9a27369300cd8f2f",
      "name": "Ollama评估",
      "type": "n8n-nodes-base.ollama",
      "typeVersion": 1,
      "position": [
        1200,
        400
      ],
      "parameters": {
        "prompt": "你是一名资深招聘顾问。请基于以下职位信息做综合评估并生成简报（用中文）：\\n职位名：{{ $json.title }}\\n公司：{{ $json.company_name }}\\n薪资：{{ $json.salary_raw }}\\n地点：{{ $json.city }}{{ $json.district }}\\n经验：{{ $json.experience }}\\n学历：{{ $json.education }}\\n描述：{{ $json.description }}\\n\\n请输出：\\n1) 技术方向判断；\\n2) 学历要求；\\n3) 经验要求；\\n4) 与「广州黄埔 AI/云计算/解决方案架构师」目标的匹配度(高/中/低)及一句话理由；\\n5) 给求职者的行动建议。",
        "model": "qwen3:8b",
        "ollamaHost": "http://host.docker.internal:11434",
        "options": {
          "temperature": 0.3
        }
      }
    },
    {
      "id": "665f84c8826b4556959455ed4d6eca53",
      "name": "组装负载",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        400
      ],
      "parameters": {
        "mode": "runForEachItem",
        "jsCode": "\nconst j = item.json;\nconst evalText = (j.text || j.output || \"\").trim();\nlet match = \"中\";\nconst m = evalText.match(/匹配度[：:]\\s*(高|中|低)/);\nif (m) match = m[1];\nconst feishu_text = `【职位评估简报】\\n职位：${j.title}\\n公司：${j.company_name}`\n  + `\\n薪资：${j.salary_raw || '面议'}\\n地点：${j.city || ''}${j.district ? ('·' + j.district) : ''}`\n  + `\\n经验：${j.experience || '-'} | 学历：${j.education || '-'}\\n\\n${evalText}`\n  + `\\n\\n🔗 ${j.job_url || ''}`;\nitem.json = Object.assign({}, j, { feishu_text, match, evaluation: evalText });\nreturn item;\n"
      }
    },
    {
      "id": "aceb0f374f8c4e91b00ba9091e0a4037",
      "name": "落看板数据",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://jobhunter2-dashboard:8100/api/jobs/ingest",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"platform\":\"={{ $json.platform }}\",\"title\":\"={{ $json.title }}\",\"company_name\":\"={{ $json.company_name }}\",\"salary_raw\":\"={{ $json.salary_raw }}\",\"city\":\"={{ $json.city }}\",\"district\":\"={{ $json.district }}\",\"experience\":\"={{ $json.experience }}\",\"education\":\"={{ $json.education }}\",\"job_url\":\"={{ $json.job_url }}\",\"description\":\"={{ $json.description }}\",\"evaluation\":\"={{ $json.evaluation }}\",\"match\":\"={{ $json.match }}\",\"crawled_at\":\"={{ $json.crawled_at }}\",\"evaluated_at\":\"={{ $now.toISO() }}\"}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "position": [
          1680,
          400
        ]
      }
    },
    {
      "id": "7eba4d0181b84502b88337808dceffac",
      "name": "筛选高匹配",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        560
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nreturn $input.all().filter(it => {\n  const mm = (it.json.match || \"\");\n  return mm === \"高\" || mm === \"中\";\n});\n"
      }
    },
    {
      "id": "2f932ad72fc044dc89e43f99653f43fb",
      "name": "发飞书群",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://open.feishu.cn/open-apis/im/v1/messages?receive_id_type=chat_id",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"receive_id\":\"={{ $vars.feishuGroupChatId }}\",\"msg_type\":\"text\",\"content\":\"={{ JSON.stringify({text: $json.feishu_text}) }}\"}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "position": [
          1920,
          560
        ],
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('获取飞书Token').first().json.tenant_access_token }}"
            }
          ]
        }
      }
    }
  ],
